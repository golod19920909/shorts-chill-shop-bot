# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Token received from @BotFather. Required to start the bot.
BOT_TOKEN=

# ---------------------------------------------------------------------------
# Google Gemini (natural-language understanding only)
# ---------------------------------------------------------------------------
# Without a key the bot still runs: a deterministic local parser is used
# for simple queries and AI comparison is disabled.
GEMINI_API_KEY=

# One primary model is used across conversational interpretation, candidate
# selection, product questions, comparison and photo understanding.
# Model names are configuration, not a guarantee that the API key can call them.
# Quota/rate-limit errors do not trigger another model (the limit is account-wide).
#
# GEMINI_PRIMARY_MODEL overrides the primary generation. Default: Gemini 3.1 Flash-Lite.
# GEMINI_RESERVE_MODEL overrides the reserve generation. Default: Gemini 3.8 Flash.
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_RESERVE_MODEL=gemini-3.8-flash
#
# Legacy GEMINI_MODEL, GEMINI_SMART_MODEL, GEMINI_FAST_MODEL,
# GEMINI_VISION_MODEL and GEMINI_FALLBACK_MODEL variables are no longer read.
# They are superseded so an older .env cannot keep 3.8 as the primary model.

# ---------------------------------------------------------------------------
# Marketplace APIs (all optional)
#
# Providers without credentials report `is_configured = False`, are
# skipped during a search, and the bot clearly tells the user which
# sources could not be searched. With credentials set, the AliExpress
# provider talks to the official Affiliate API (TOP protocol, see
# services/marketplaces/aliexpress_client.py for the details).
# ---------------------------------------------------------------------------
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Affiliate tracking id. NOT used yet: the bot links users with the real
# `promotion_link` that the affiliate API returns with each product
# (search and promo feeds). A tracking id would only become necessary if
# `aliexpress.affiliate.link.generate` were implemented, and that method
# additionally requires an account level this project does not have.
# ALIEXPRESS_TRACKING_ID=

# ---------------------------------------------------------------------------
# Administration
# ---------------------------------------------------------------------------
# Telegram user ids allowed to open the admin panel (/admin), comma
# separated. Empty (the default) means nobody is an administrator: the
# panel then says that ADMIN_IDS is not configured instead of showing data.
#
# How to find your id: write to @userinfobot - it replies with your id.
# ADMIN_IDS=123456789,987654321

# ---------------------------------------------------------------------------
# Price tracking
# ---------------------------------------------------------------------------
# How often the automatic scheduler re-checks tracked product prices
# (services/price_tracker.py, application JobQueue). 0 disables automatic
# checks entirely - the tracking screen then reports manual tracking.
# The default of 1440 minutes (24 hours) is the agreed cadence: a price
# move is checked once a day, which keeps tracked products far below the
# AliExpress affiliate rate limits.
TRACKING_INTERVAL_MINUTES=1440

# ---------------------------------------------------------------------------
# Retrieval depth (how many REAL marketplace calls a search may cost)
# ---------------------------------------------------------------------------
# A narrow query is answered with a thin first page; these budgets let the bot
# ask the same grounded phrase (or the same pictorial hypothesis) for its NEXT
# documented result page instead of starving the pool the user browses. Every
# unit is a real API call, so all three values are clamped at startup:
#
#   SEARCH_MAX_PAGES        - maximum documented pages for a text search;
#                             conversational search continues each live grounded
#                             route until its candidate target or time budget
#                             (1..10, default 5);
#   PHOTO_SEARCH_PAGES      - pages of ONE photo hypothesis (1..5, default 2);
#   PHOTO_SEARCH_HYPOTHESES - grounded questions ONE photo may ask in total
#                             (1..6, default 4).
#
# Deeper pages are only requested while the RELEVANT pool is still short of the
# result cap, so the worst case stays bounded by these numbers. With a working
# GEMINI_API_KEY the cap of a search is the AI pool (80 raw listings), because
# the model is asked to drop junk and keep the best 20 cards; without a key the
# cap stays at the deterministic 30 and no extra page is requested.
SEARCH_MAX_PAGES=5
PHOTO_SEARCH_PAGES=2
PHOTO_SEARCH_HYPOTHESES=4

# ---------------------------------------------------------------------------
# «✨ Находки» (G24): бюджеты ОДНОГО открытия ленты. Источник — официальный
# AliExpress `product.query` БЕЗ keywords и БЕЗ sort: порядок и состав ленты
# определяет сам маркетплейс, бот не ранжирует и не отбирает товары.
# Оба значения читаются в config/settings.py и клампятся там же.
#
#   FEED_OPEN_SIZE          - сколько товаров МАКСИМУМ загружается в одну
#                             feed session (1..100, default 20): это объём
#                             RAM-pool, из которого карточки выдаются без
#                             повторных запросов к API;
#   FEED_MAX_PAGES_PER_OPEN - максимум страниц AliExpress (documented
#                             page_no, page_size = 50), запрашиваемых за
#                             ОДНО новое открытие ленты (1..10, default 2);
#                             курсор следующего открытия = последняя
#                             запрошенная страница + 1.
# ---------------------------------------------------------------------------
FEED_OPEN_SIZE=20
FEED_MAX_PAGES_PER_OPEN=2

# ---------------------------------------------------------------------------
# Optional Gemini analytics web dashboard (read-only)
# ---------------------------------------------------------------------------
# Disabled unless a strong password is set. By default it binds only to
# 127.0.0.1 so it is reachable from this computer, not from the public network.
# On a server, keep it bound to 127.0.0.1 and expose it through an HTTPS
# reverse proxy. Never expose Basic Auth over plain public HTTP.
#
# ANALYTICS_DASHBOARD_USERNAME=admin
# ANALYTICS_DASHBOARD_PASSWORD=replace-with-a-long-random-password
# ANALYTICS_DASHBOARD_HOST=127.0.0.1
# ANALYTICS_DASHBOARD_PORT=8765

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Relative paths are resolved against the project root.
DATABASE_PATH=database/shop_bot.db

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
